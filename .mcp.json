{
  "mcpServers": {
    "quick-image": {
      "type": "http",
      "url": "https://quickimage.ai/mcp",
      "headers": {
        "X-Quick-Image-Plugin-Version": "0.2.2",
        "X-Quick-Image-Frontend-URL": "https://quickimage.ai"
      },
      "http_headers": {
        "X-Quick-Image-Plugin-Version": "0.2.2",
        "X-Quick-Image-Frontend-URL": "https://quickimage.ai"
      }
    },
    "quick-image-local": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "--package",
        "quick-image-agent-runtime@0.3.1",
        "quick-image-local-mcp"
      ]
    }
  }
}
